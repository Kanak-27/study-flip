# API server
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/studyflip

# Session secret — generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Origin of the React client, for CORS with credentials
CLIENT_ORIGIN=http://localhost:5173

# Email — used for signup verification codes, password resets and security
# notices. Any SMTP provider works. In development, leaving SMTP_HOST empty logs
# the codes to the console and returns `devCode` in the API response so you can
# sign up without email. In production, OTP flows return 503 until SMTP is set.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and
# SMTP_PASS=<16-character App Password>. The normal account password will not
# work — enable 2-Step Verification and create an App Password. Spaces are fine;
# they are stripped automatically for smtp.gmail.com.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false               # true for implicit TLS (usually port 465)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=StudyFlip <no-reply@example.com>
# OTP_TTL_MINUTES=10             # code lifetime
# OTP_MAX_ATTEMPTS=5             # wrong guesses before the code is dead
# OTP_RESEND_SECONDS=60          # cooldown between sends
# OTP_MAX_SENDS=5                # codes per address per challenge

# Comma-separated addresses promoted to admin on signup/sign-in. The admin
# panel can also promote accounts, and `npm run make-admin -- email` works for
# existing users.
# ADMIN_EMAILS=you@example.com

# AI provider: Groq (https://console.groq.com/keys). Optional — without a key,
# generation runs fail gracefully with a clear error.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b

# Cashfree Payments — subscriptions. Optional: leave the credentials empty and
# billing stays disabled (checkout returns 404), everything else keeps working.
# CASHFREE_ENV=sandbox            # sandbox | production
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_PLAN_ID=               # optional; created automatically when empty
# CASHFREE_PLAN_AMOUNT=699        # monthly price in INR
# CASHFREE_API_VERSION=2025-01-01
# CASHFREE_WEBHOOK_SECRET=        # optional; the client secret is accepted too
# BILLING_RETURN_URL=             # optional; defaults to CLIENT_ORIGIN/api/billing/return
