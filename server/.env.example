# API server
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/studyflip

# Session secret — generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Origin of the React client, for CORS with credentials
CLIENT_ORIGIN=http://localhost:5173

# AI provider: Groq (https://console.groq.com/keys). Optional — without a key,
# generation runs fail gracefully with a clear error.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b

# Cashfree Payments — subscriptions. Optional: leave the credentials empty and
# billing stays disabled (checkout returns 404), everything else keeps working.
# CASHFREE_ENV=sandbox            # sandbox | production
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_PLAN_ID=               # optional; created automatically when empty
# CASHFREE_PLAN_AMOUNT=699        # monthly price in INR
# CASHFREE_API_VERSION=2025-01-01
# CASHFREE_WEBHOOK_SECRET=        # optional; the client secret is accepted too
